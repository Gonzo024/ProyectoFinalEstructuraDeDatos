<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Modulo 3: programaciones, notificaciones y analisis de gastos.
    Solo cambia el aspecto (css/monedero.css). Los fx:id, los onAction y el controlador
    son exactamente los mismos. La tabla de programaciones sigue dentro de un VBox,
    porque el controlador agrega ahi los botones de simulacion de vencimientos.
-->

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.poo.vista.ModuloTresController"
      styleClass="raiz"
      stylesheets="@../css/monedero.css">

    <!-- ENCABEZADO -->

    <VBox styleClass="encabezado" spacing="4">
        <Label text="Monedero Virtual"
               styleClass="encabezado-titulo"/>
        <Label text="Programaciones · Notificaciones · Analisis de gastos"
               styleClass="encabezado-subtitulo"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE"
             VBox.vgrow="ALWAYS">

        <tabs>

            <!-- ============================================ PROGRAMACIONES -->

            <Tab text="Programaciones">

                <VBox styleClass="contenido-pestana">

                    <VBox styleClass="tarjeta">

                        <Label text="Transacciones programadas"
                               styleClass="titulo-seccion"/>

                        <Label text="Registra operaciones futuras. No se mueve dinero hasta su ejecucion."
                               styleClass="texto-ayuda"/>

                        <HBox spacing="10">

                            <TextField fx:id="txtClienteProgramacion"
                                       promptText="ID del cliente (C1)"
                                       HBox.hgrow="ALWAYS"/>

                            <TextField fx:id="txtMonederoProgramacion"
                                       promptText="ID del monedero (M1)"
                                       HBox.hgrow="ALWAYS"/>

                            <ComboBox fx:id="comboTipo"
                                      prefWidth="210"
                                      promptText="Tipo de transaccion"/>

                        </HBox>

                        <HBox spacing="10">

                            <TextField fx:id="txtMontoProgramacion"
                                       promptText="Monto"
                                       HBox.hgrow="ALWAYS"/>

                            <ComboBox fx:id="comboFrecuencia"
                                      prefWidth="160"
                                      promptText="Frecuencia"/>

                            <DatePicker fx:id="fechaProgramacion"
                                        promptText="Fecha futura"/>

                            <TextField fx:id="txtHoraProgramacion"
                                       promptText="HH:mm"
                                       prefWidth="90"/>

                        </HBox>

                        <Label text="Destino (obligatorio para transferencias)"
                               styleClass="etiqueta-valor"/>

                        <HBox spacing="10">

                            <TextField fx:id="txtClienteDestino"
                                       promptText="ID cliente destino"
                                       HBox.hgrow="ALWAYS"/>

                            <TextField fx:id="txtMonederoDestino"
                                       promptText="ID monedero destino"
                                       HBox.hgrow="ALWAYS"/>

                        </HBox>

                        <HBox spacing="10">

                            <Button text="Programar"
                                    styleClass="boton-primario"
                                    onAction="#crearProgramacion"/>

                            <Button fx:id="btnConsultarSiguiente"
                                    text="Consultar siguiente"
                                    styleClass="boton-secundario"
                                    onAction="#consultarSiguienteProgramacion"/>

                            <Button text="Cancelar seleccionada"
                                    styleClass="boton-peligro"
                                    onAction="#cancelarProgramacion"/>

                        </HBox>

                    </VBox>

                    <!-- El controlador agrega aqui los botones de simulacion, encima de la tabla. -->
                    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">

                        <Label fx:id="lblEstadoProgramaciones"
                               text="Programaciones pendientes: 0"
                               styleClass="titulo-seccion"/>

                        <TableView fx:id="tablaProgramaciones"
                                   VBox.vgrow="ALWAYS"
                                   minHeight="140">
                            <columns>
                                <TableColumn fx:id="colProgId"
                                             text="ID"
                                             prefWidth="75"/>
                                <TableColumn fx:id="colProgTipo"
                                             text="Tipo"
                                             prefWidth="170"/>
                                <TableColumn fx:id="colProgMonto"
                                             text="Monto"
                                             prefWidth="130"/>
                                <TableColumn fx:id="colProgFecha"
                                             text="Fecha y hora"
                                             prefWidth="175"/>
                                <TableColumn fx:id="colProgFrecuencia"
                                             text="Frecuencia"
                                             prefWidth="135"/>
                            </columns>
                        </TableView>

                        <Label text="Los movimientos se almacenan en memoria. No se ejecutan transferencias ni pagos automaticamente."
                               wrapText="true"
                               styleClass="texto-ayuda"/>

                    </VBox>

                </VBox>

            </Tab>

            <!-- ============================================ NOTIFICACIONES -->

            <Tab text="Notificaciones">

                <VBox styleClass="contenido-pestana">

                    <VBox styleClass="tarjeta">

                        <Label text="Mis notificaciones"
                               styleClass="titulo-seccion"/>

                        <Label text="Consulta las notificaciones de un cliente."
                               styleClass="texto-ayuda"/>

                        <HBox spacing="10">

                            <TextField fx:id="txtClienteNotificacion"
                                       promptText="ID del cliente, por ejemplo C1"
                                       HBox.hgrow="ALWAYS"/>

                            <Button text="Consultar"
                                    styleClass="boton-primario"
                                    onAction="#consultarNotificaciones"/>

                            <Button fx:id="btnAvisoPrueba"
                                    text="Crear aviso de prueba"
                                    styleClass="boton-secundario"
                                    onAction="#crearNotificacionPrueba"/>

                            <Button text="Marcar como leida"
                                    styleClass="boton-secundario"
                                    onAction="#marcarNotificacionLeida"/>

                        </HBox>

                    </VBox>

                    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">

                        <Label fx:id="lblCantidadNoLeidas"
                               text="Notificaciones sin leer: 0"
                               styleClass="titulo-seccion"/>

                        <TableView fx:id="tablaNotificaciones"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="columnaId"
                                             text="ID"
                                             prefWidth="90"/>
                                <TableColumn fx:id="columnaTipo"
                                             text="Tipo"
                                             prefWidth="170"/>
                                <TableColumn fx:id="columnaMensaje"
                                             text="Mensaje"
                                             prefWidth="350"/>
                                <TableColumn fx:id="columnaLeida"
                                             text="Leida"
                                             prefWidth="100"/>
                            </columns>
                        </TableView>

                    </VBox>

                </VBox>

            </Tab>

            <!-- ============================================ ANALISIS DE GASTOS -->

            <Tab text="Analisis de gastos">

                <VBox styleClass="contenido-pestana">

                    <VBox styleClass="tarjeta">

                        <Label text="Reporte de gastos"
                               styleClass="titulo-seccion"/>

                        <Label text="Consulta los gastos de todos los monederos de un cliente."
                               styleClass="texto-ayuda"/>

                        <HBox spacing="10">

                            <TextField fx:id="txtClienteGastos"
                                       promptText="ID del cliente"
                                       HBox.hgrow="ALWAYS"/>

                            <Button fx:id="btnDatosDemostracion"
                                    text="Cargar datos de demostracion"
                                    styleClass="boton-secundario"
                                    onAction="#cargarDatosDemostracion"/>

                        </HBox>

                        <HBox spacing="10">

                            <TextField fx:id="txtAnioGastos"
                                       promptText="Año"
                                       prefWidth="100"/>

                            <TextField fx:id="txtMesGastos"
                                       promptText="Mes"
                                       prefWidth="80"/>

                            <Button text="Consultar gastos"
                                    styleClass="boton-primario"
                                    onAction="#consultarGastos"/>

                        </HBox>

                    </VBox>

                    <VBox styleClass="tarjeta" VBox.vgrow="ALWAYS">

                        <HBox spacing="10">

                            <VBox spacing="4" HBox.hgrow="ALWAYS">

                                <Label fx:id="lblCategoriaMayor"
                                       text="Categoria con mayor gasto: Ninguna"
                                       styleClass="titulo-seccion"/>

                                <Label fx:id="lblEstadoGastos"
                                       text="Sin consulta"
                                       styleClass="mensaje-estado"/>

                            </VBox>

                            <Label fx:id="lblTotalGastos"
                                   text="Total gastado: $0.00"
                                   styleClass="valor-grande"/>

                        </HBox>

                        <TableView fx:id="tablaGastos"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="columnaCategoriaGastos"
                                             text="Categoria"
                                             prefWidth="300"/>
                                <TableColumn fx:id="columnaTotalGastos"
                                             text="Total gastado"
                                             prefWidth="220"/>
                            </columns>
                        </TableView>

                        <Label text="Los datos de demostracion son temporales y no modifican saldos."
                               styleClass="texto-ayuda"/>

                    </VBox>

                </VBox>

            </Tab>

        </tabs>

    </TabPane>

</VBox>