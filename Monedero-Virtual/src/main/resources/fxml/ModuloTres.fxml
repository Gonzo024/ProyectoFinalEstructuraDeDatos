<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.poo.vista.ModuloTresController"
      spacing="15"
      style="-fx-background-color: #F4F6FA;">

    <padding>
        <Insets top="25" right="25"
                bottom="25" left="25"/>
    </padding>

    <Label text="Monedero Virtual"
           style="-fx-font-size: 26px;
                  -fx-font-weight: bold;"/>

    <Label text="Programaciones, notificaciones y analisis de gastos"
           style="-fx-font-size: 14px;
                  -fx-text-fill: #666666;"/>

    <TabPane tabClosingPolicy="UNAVAILABLE"
             VBox.vgrow="ALWAYS">

        <tabs>

            <!-- PROGRAMACIONES -->
            <!-- La conectaremos en el siguiente commit. -->

            <Tab text="Programaciones">

                <VBox spacing="15"
                      style="-fx-padding: 20;">

                    <Label text="Transacciones programadas"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Label text="Programa operaciones para una fecha futura."/>

                    <TextField promptText="ID del cliente"/>

                    <TextField promptText="ID del monedero origen"/>

                    <TextField promptText="Monto"/>

                    <DatePicker promptText="Fecha de ejecucion"/>

                    <ComboBox promptText="Frecuencia"/>

                    <HBox spacing="10">

                        <Button text="Programar"/>

                        <Button text="Cancelar programacion"/>

                    </HBox>

                    <TableView VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn text="ID"
                                         prefWidth="100"/>

                            <TableColumn text="Tipo"
                                         prefWidth="150"/>

                            <TableColumn text="Monto"
                                         prefWidth="150"/>

                            <TableColumn text="Fecha"
                                         prefWidth="180"/>

                            <TableColumn text="Frecuencia"
                                         prefWidth="150"/>

                        </columns>

                    </TableView>

                </VBox>

            </Tab>

            <!-- NOTIFICACIONES -->

            <Tab text="Notificaciones">

                <VBox spacing="15"
                      style="-fx-padding: 20;">

                    <Label text="Mis notificaciones"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Label text="Consulta las notificaciones de un cliente."/>

                    <TextField fx:id="txtClienteNotificacion"
                               promptText="ID del cliente, por ejemplo C1"/>

                    <HBox spacing="10">

                        <Button text="Consultar"
                                onAction="#consultarNotificaciones"/>

                        <Button text="Crear aviso de prueba"
                                onAction="#crearNotificacionPrueba"/>

                        <Button text="Marcar como leida"
                                onAction="#marcarNotificacionLeida"/>

                    </HBox>

                    <Label fx:id="lblCantidadNoLeidas"
                           text="Notificaciones sin leer: 0"
                           style="-fx-font-weight: bold;"/>

                    <TableView fx:id="tablaNotificaciones"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="columnaId"
                                         text="ID"
                                         prefWidth="90"/>

                            <TableColumn fx:id="columnaTipo"
                                         text="Tipo"
                                         prefWidth="170"/>

                            <TableColumn fx:id="columnaMensaje"
                                         text="Mensaje"
                                         prefWidth="350"/>

                            <TableColumn fx:id="columnaLeida"
                                         text="Leida"
                                         prefWidth="100"/>

                        </columns>

                    </TableView>

                </VBox>

            </Tab>

            <!-- ANALISIS DE GASTOS -->

            <Tab text="Analisis de gastos">

                <VBox spacing="15"
                      style="-fx-padding: 20;">

                    <Label text="Reporte de gastos"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;"/>

                    <Label text="Consulta los gastos de todos los monederos de un cliente."/>

                    <HBox spacing="10">

                        <TextField fx:id="txtClienteGastos"
                                   promptText="ID del cliente"
                                   HBox.hgrow="ALWAYS"/>

                        <Button text="Cargar datos de demostracion"
                                onAction="#cargarDatosDemostracion"/>

                    </HBox>

                    <HBox spacing="10">

                        <TextField fx:id="txtAnioGastos"
                                   promptText="Año"
                                   prefWidth="100"/>

                        <TextField fx:id="txtMesGastos"
                                   promptText="Mes"
                                   prefWidth="80"/>

                        <Button text="Consultar gastos"
                                onAction="#consultarGastos"/>

                    </HBox>

                    <Label fx:id="lblTotalGastos"
                           text="Total gastado: $0.00"
                           style="-fx-font-size: 22px;
                                  -fx-font-weight: bold;"/>

                    <Label fx:id="lblCategoriaMayor"
                           text="Categoria con mayor gasto: Ninguna"
                           style="-fx-font-size: 15px;"/>

                    <Label fx:id="lblEstadoGastos"
                           text="Sin consulta"
                           style="-fx-text-fill: #666666;"/>

                    <TableView fx:id="tablaGastos"
                               VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="columnaCategoriaGastos"
                                         text="Categoria"
                                         prefWidth="300"/>

                            <TableColumn fx:id="columnaTotalGastos"
                                         text="Total gastado"
                                         prefWidth="220"/>

                        </columns>

                    </TableView>

                    <Label text="Los datos de demostracion son temporales y no modifican saldos."
                           style="-fx-font-size: 12px;
                                  -fx-text-fill: #777777;"/>

                </VBox>

            </Tab>

        </tabs>

    </TabPane>

</VBox>
